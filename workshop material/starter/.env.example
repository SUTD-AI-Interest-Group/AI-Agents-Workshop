# Copy this file to .env:  cp .env.example .env
# Then add your values.

# --- Model (required) -------------------------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Use a model from https://openrouter.ai/models. Put "openrouter/" before the model ID.
# Use a model that supports tool calling. Examples:
#   openrouter/anthropic/claude-haiku-5.5    (low cost, default)
#   openrouter/openai/gpt-5.6-luna
#   openrouter/google/gemini-3.8-flash
MODEL=openrouter/anthropic/claude-haiku-5.5
# Embedding model for memory (also through OpenRouter)
EMBEDDING_MODEL=openai/text-embedding-3-small
# Maximum tokens for each request. The models above support more.
CONTEXT_WINDOW=200000

# --- Step 3: web search (optional) -----------------------------------------
FIRECRAWL_API_KEY=fc-...

# --- Steps 3 and 5: canvas platform (copy from the Crew tab of the canvas) --
BOARD_URL=
CREW_TOKEN=
CANVAS_MCP_URL=
# The remote webhook for cards. If this is empty, the cards go to ./outbox/
WEBHOOK_URL=

# --- Your team ---------------------------------------------------------------
TEAM_NAME=my-team
